{
  "name": "hafagolf",
  "version": "1.0.0",
  "private": true,
  "description": "HafaGolf — multi-client golf tournament management platform by Shimizu Technology",
  "scripts": {
    "api:dev": "cd api && bin/rails server",
    "web:dev": "cd web && npm run dev",
    "dev": "concurrently \"pnpm api:dev\" \"pnpm web:dev\"",
    "build": "cd web && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
