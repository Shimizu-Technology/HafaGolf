# HafaGolf Web - Environment Variables

# API URL
VITE_API_URL=http://localhost:3000

# Admin Console Origin (Clerk is lazy-loaded ONLY on this host and local dev)
VITE_ADMIN_ORIGIN=https://golf.shimizu-technology.com

# Clerk Authentication (required ONLY on the admin host, NOT on client public domains)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# WebSocket URL (ActionCable)
VITE_WS_URL=ws://localhost:3000/cable
