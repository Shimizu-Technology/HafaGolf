# HafaGolf API - Environment Variables

# Database
# Leave DATABASE_URL unset locally so config/database.yml cleanly separates
# hafagolf_development and hafagolf_test. Set DATABASE_URL in staging/production.
# DATABASE_URL=postgresql://localhost/hafagolf_development

# Clerk Authentication (single admin app on golf.shimizu-technology.com)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWKS_URL=

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend Email
RESEND_API_KEY=re_replace_me
MAILER_FROM_EMAIL=noreply@shimizu-technology.com

# Delivery status callbacks (Resend + ClickSend)
# Required — webhooks fail closed (401) if no token is configured.
DELIVERY_WEBHOOK_TOKEN=replace_with_random_token

# Frontend URL (for CORS, emails, local dev)
FRONTEND_URL=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173

# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=
ENABLE_RATE_LIMITING=false
WEB_CONCURRENCY=0
SOLID_QUEUE_IN_PUMA=false

# AWS S3 (Active Storage - production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# AWS_S3_BUCKET= # also supported instead of AWS_BUCKET
